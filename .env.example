# Copy to .env.local and fill in. .env.local is gitignored; never commit keys.
# Set the same values in Vercel → Project → Settings → Environment Variables.
# The site builds and runs without any of them: each feature below simply
# shows its "not connected yet" state until its key is set.

# ── Supabase (Reads, /care, the employer portal) ─────────────────────────────
# Public by design: the anon key only reads rows RLS marks as published.
# Same two values the old site (parentveda-web) used.
NEXT_PUBLIC_SUPABASE_URL=https://csrabzuhxbschkeyohha.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Writes waitlist signups. It bypasses Row Level
# Security completely: never prefix it with NEXT_PUBLIC_, never import it
# into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — lets Directus clear the Reads cache on publish (POST /api/revalidate
# with header x-revalidate-secret). Any long random string; the same value
# goes into the Directus Flow. Unset = the endpoint refuses (fails closed).
REVALIDATE_SECRET=

# ── Contact form (/contact → /api/contact, sent through Resend) ──────────────
# From https://resend.com → API Keys
RESEND_API_KEY=

# The inbox that receives contact-form messages
CONTACT_TO_EMAIL=

# The sender. Must be on a domain verified in Resend (e.g. hello@parentveda.in).
# Until the domain is verified, Resend's test sender works, but it only
# delivers to the email address your Resend account was created with.
CONTACT_FROM_EMAIL=ParentVeda <onboarding@resend.dev>

# ── SEO, affiliate and analytics ─────────────────────────────────────────────
# All optional. Each feature stays off until its value is set.
# The NEXT_PUBLIC_ and verification values are read at build time: redeploy after changing them.

# Your Amazon Associates tag, applied to every amazon.in link when the page renders.
# Changing accounts only needs this one value. Unset leaves links as written.
AMAZON_ASSOCIATE_TAG=pvweb-21

# Google Analytics 4 Measurement ID (G-XXXXXXX). Setting it turns on the consent
# banner; the Google script loads only after a visitor accepts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# 32 hex characters. Served publicly at /<key>.txt, and used to ping Bing on publish.
INDEXNOW_KEY=

# Homepage ownership tags. Printed only when set.
PINTEREST_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Images uploaded in Directus live in a private Cloudflare R2 bucket. The site
# serves them at /cms-media/<file id>/ (lib/cms-media.ts, lib/r2.ts) using an
# R2 API token with "Object Read only" on that one bucket. Server-only; never
# prefix these with NEXT_PUBLIC_. Until all four are set, /cms-media/ returns 404
# and only images kept in public/media show.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only if the Directus service on Render sets STORAGE_R2_ROOT: the same value.
R2_ROOT=
